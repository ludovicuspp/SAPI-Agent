# ── Base de datos ──────────────────────────────────────────────
SAPI_DB_PATH=data/sapi.db

# ── API ────────────────────────────────────────────────────────
# Dev: la API expone en 0.0.0.0 para que Vite (dev) la alcance via proxy.
# En producción detras de un reverse proxy usa 127.0.0.1.
API_HOST=0.0.0.0
API_PORT=8000
# CORS: en dev habilita el origin del dev server de Vite.
# En producción (mismo origen via proxy) duplica el dominio publico.
API_CORS_ORIGINS=http://localhost:5173

# ── Seguridad ──────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambiar-en-produccion-token-seguro-de-64-chars-minimo
JWT_EXPIRES_MIN=480

# ── Matching ───────────────────────────────────────────────────
MATCH_THRESHOLD=85
FUZZY_THRESHOLD=80
PHONETIC_THRESHOLD=0.75

# ── Notificaciones email (SMTP) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SAPI-Agent <noreply@sapi-agent.local>
NOTIFY_COOLDOWN_HOURS=24

# ── Uploads ────────────────────────────────────────────────────
MAX_UPLOAD_MB=50

# ── Hermes (Fase 5) ────────────────────────────────────────────
HERMES_API_URL=http://localhost:8000
# Service token que Hermes usa para llamar a POST /api/boletines/{id}/structured
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_TOKEN_HERMES=poner-token-seguro-aqui-48-chars-minimo

# ── Admin inicial (seed en init-db) ─────────────────────────────
# Si están definidos y no existe ningún admin, `init-db` crea este usuario.
ADMIN_EMAIL=admin@sapi-agent.local
ADMIN_PASSWORD=cambiar-en-primer-arranque
